{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "promptbase",
    "main": "dist/_worker.js/index.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "compatibility_date": "2025-02-04",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "observability": {
        "enabled": true
    }
}